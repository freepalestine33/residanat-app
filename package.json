{
  "name": "residanat-smart-learning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc --noEmit -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "export:content": "node scripts/export-content.mjs",
    "validate:content": "tsx scripts/validate-content.ts",
    "lecture:check": "tsx scripts/check-lecture.ts",
    "lecture:draft": "tsx scripts/draft-lecture.ts",
    "lecture:import": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/import-lecture.ts",
    "lecture:publish": "tsx scripts/publish-lecture.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dexie": "^4.4.7",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^30.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "pdfjs-dist": "^5.4.149",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
